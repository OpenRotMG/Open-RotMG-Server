[Unit]
Description=Deploy the latest tested Open RotMG main revision
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/flock -n /run/lock/openrotmg-deploy.lock /usr/bin/python3 /opt/openrotmg-deploy/update.py
TimeoutStartSec=15min
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/openrotmg /opt/openrotmg-backup /var/lib/openrotmg-deploy /var/lib/openrotmg /run/lock
InaccessiblePaths=/etc/openrotmg-discord-bot/token /etc/openrotmg-backup/github-token
# The rehearsal game-server child loads a full-size Realm in this cgroup.
MemoryMax=1G
CPUQuota=20%
