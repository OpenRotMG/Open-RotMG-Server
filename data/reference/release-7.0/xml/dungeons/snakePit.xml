		<State id="start_the_fun">			
			<Behavior effect="Invulnerable">ConditionEffect</Behavior>
			<Transition playerWithin="12">pet_help</Transition>
			<Transition hitpointsLessThan="0.999">pet_help</Transition>
		</State>
		<State id="pet_help">	
			<Behavior childIds="Stheno Pet" cooldown="1.5" maxChildren="4" startWithMinions="false">MakeMinions</Behavior>

			<State id="wait_for_pets">
				<Behavior effect="Invulnerable">ConditionEffect</Behavior>

				<Behavior bucket="movement" range="4" speed="0.4">StayCloseToSpawn</Behavior>
				<Behavior bucket="movement" speed="0.4">Wander</Behavior>

				<Transition afterTime="3">attack1</Transition>
			</State>
			<State id="attack1">
				<State id="unshielded1">
					<Behavior numShots="2" projectileId="0" cooldown="0.7" type="targeted" predictive="0.15" angle="80">Shoot</Behavior>
					<Behavior numShots="4" projectileId="0" cooldown="0.7" type="targeted" predictive="0.15" angle="90">Shoot</Behavior>
				
					<Transition afterTime="1">shielded1</Transition>
				</State>
				<State id="shielded1">
					<Behavior effect="Invulnerable">ConditionEffect</Behavior>
					<Behavior numShots="2" projectileId="0" cooldown="0.7" type="targeted" predictive="0.15" angle="80">Shoot</Behavior>
					<Behavior numShots="4" projectileId="0" cooldown="0.7" type="targeted" predictive="0.15" angle="90">Shoot</Behavior>
				
					<Transition afterTime="3">unshielded1</Transition>
				</State>
			
				<Transition afterTime="8">summon_snakes</Transition>
			</State>		
			<State id="summon_snakes">
				<Behavior childIds="Stheno Swarm" cooldown="0.4" maxChildren="6" startWithMinions="false">MakeMinions</Behavior>
				
				<Behavior bucket="movement" range="4" speed="0.6">StayCloseToSpawn</Behavior>
				<Behavior bucket="movement" speed="0.6">Wander</Behavior>				

				<State id="unshielded3">
					<Behavior numShots="3" projectileId="0" cooldown="0.8" type="targeted" predictive="0.05" offset="0.5" angle="90">Shoot</Behavior>
				
					<Transition afterTime="1">shielded3</Transition>
				</State>
				<State id="shielded3">
					<Behavior effect="Invulnerable">ConditionEffect</Behavior>
					<Behavior numShots="3" projectileId="0" cooldown="0.8" type="targeted" predictive="0.05" offset="0.5" angle="90">Shoot</Behavior>
				
					<Transition afterTime="3">unshielded3</Transition>
				</State>
			
				<Transition afterTime="12">chance_to_clear_snakes</Transition>
			</State>
			<State id="chance_to_clear_snakes">
				<Behavior effect="Invulnerable">ConditionEffect</Behavior>

				<Behavior bucket="movement" range="4" speed="0.4">StayCloseToSpawn</Behavior>
				<Behavior bucket="movement" speed="0.4">Wander</Behavior>

				<Transition afterTime="5">attack2</Transition>
			</State>			
			<State id="attack2">
				<State id="unshielded2">
					<Behavior numShots="6" projectileId="1" cooldown="0.4" type="targeted" angle="60">Shoot</Behavior>
					<Behavior cooldown="1" type="targeted" radius="2.7" damage="100">GrenadeToss</Behavior>					

					<Transition afterTime="1.5">shielded2</Transition>
				</State>
				<State id="shielded2">
					<Behavior effect="Invulnerable">ConditionEffect</Behavior>

					<Behavior numShots="6" projectileId="1" cooldown="0.4" type="targeted" angle="60">Shoot</Behavior>
					<Behavior cooldown="1" type="targeted" radius="2.7" damage="100">GrenadeToss</Behavior>	
				
					<Transition afterTime="2.5">unshielded2</Transition>
				</State>			
		
				<Transition afterTime="8">attack1</Transition>
			</State>
		</State>
	</Object>
	

