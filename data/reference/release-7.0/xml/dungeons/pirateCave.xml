     Revised Dreadstump the Pirate King
     ready for testing
     
     *********************************************************************************
     -->
	<Object type="0x0927" id="Dreadstump the Pirate King">
		<Enemy/>
		<Class>Character</Class>
		<AnimatedTexture><File>chars16x16dEncounters</File><Index>4</Index></AnimatedTexture>
		<HitSound>monster/pirate_king_hit</HitSound>
		<DeathSound>monster/pirate_king_death</DeathSound>
		<Size>80</Size>
		<MaxHitPoints>800</MaxHitPoints>
		<Defense>3</Defense>
		<Quest/>
		<StasisImmune/>
		<Level>1</Level>
		<XpMult>0.8</XpMult>
		<NoArticle/>
		
		<Projectile id="0">
			<ObjectId>Blade</ObjectId>
			<Damage>17</Damage>
			<Speed>75</Speed>
			<LifetimeMS>1500</LifetimeMS>
		</Projectile>
		<Projectile id="1">
			<ObjectId>Black Ball</ObjectId>
			<Damage>25</Damage>
			<Speed>130</Speed>
			<LifetimeMS>1100</LifetimeMS>
		</Projectile>
        
		<State id="Start">			
			<Behavior bucket="movement" speed="0.65">Wander</Behavior>
			<Behavior bucket="movement" range="6" speed="0.65">StayCloseToSpawn</Behavior>
			<Transition hitpointsLessThan=".9999">Boast</Transition>						
		</State>
		<State id="Boast">
			<Behavior prob="1" text="Hah! I'll drink my rum out of your skull!">Say</Behavior>
			
			<Behavior bucket="movement" speed="0.65">Wander</Behavior>
			<Behavior bucket="movement" range="6" speed="0.65">StayCloseToSpawn</Behavior>
			
			<Behavior projectileId="0" cooldown="0.5" range="8">Shoot</Behavior>
			
			<Transition afterTime="3">Normal</Transition>
		</State>		
		<State id="Normal">
			<Behavior prob="1" text="Arrrr...">Say</Behavior>
			
			<Behavior projectileId="0" cooldown="0.5" range="8">Shoot</Behavior>
			<Behavior projectileId="1" cooldown="2.5" range="10" blastEffect="1">Shoot</Behavior>
            
			<Behavior bucket="movement" speed="0.65">Wander</Behavior>
			<Behavior bucket="movement" range="6" speed="0.65">StayCloseToSpawn</Behavior>		
            
			<Transition afterTime="6.5">Cannon_Cluster</Transition>
		</State>	
		<State id="Cannon_Cluster">
			<Behavior prob="1" text="Eat cannonballs!">Say</Behavior>
            
			<Behavior bucket="movement" range="6" speed="0.4">StayCloseToSpawn</Behavior>
			<Behavior bucket="movement" acquireRange="5" distance="5" speed="0.4">Circle</Behavior>
            
			<Behavior numShots="1" projectileId="1" cooldown="5" type="targeted" offset="1.8" blastEffect="1">Shoot</Behavior>
			<Behavior numShots="1" projectileId="1" cooldown="5" type="targeted" offset="2.2" blastEffect="1">Shoot</Behavior>
			<Behavior numShots="1" projectileId="1" cooldown="5" type="targeted" offset="2.6" blastEffect="1">Shoot</Behavior>
			
			<Transition afterTime="4">Normal</Transition>
		</State>
		
		<Behavior prob="1" childId="Realm Portal">MetamorphoseAtDeath</Behavior>
		
		<SoulboundLoot tier="2" prob=".20" threshold=".10">Weapon</SoulboundLoot>
		<SoulboundLoot tier="3" prob=".10" threshold=".18">Weapon</SoulboundLoot>
		<SoulboundLoot tier="4" prob=".05" threshold=".18">Weapon</SoulboundLoot>
		<SoulboundLoot tier="1" prob=".2" threshold=".10">Armor</SoulboundLoot>
		<SoulboundLoot tier="2" prob=".1" threshold=".10">Armor</SoulboundLoot>
		<SoulboundLoot tier="3" prob=".05" threshold=".18">Armor</SoulboundLoot>
		<SoulboundLoot tier="4" prob=".02" threshold=".18">Armor</SoulboundLoot>
		<SoulboundLoot tier="1" prob=".05" threshold=".18">Ring</SoulboundLoot>
		<SoulboundLoot prob="0.01" threshold=".18">Pirate Rum</SoulboundLoot>
	</Object>
    
