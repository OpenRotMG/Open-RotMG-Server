			<Transition noTag="p2done" hitpointsLessThan=".35">ThrowOff</Transition>	
			<Transition noTag="p3done" hitpointsLessThan=".08">ThrowOff</Transition>
			
			<Transition afterTime="3" noneExist="Coffin Creature">ThrowCoffins</Transition>
			<Transition afterTime="7" hitpointsLessThan="0.8">DualSwarms</Transition>
			<Transition afterTime="7">TurnIntoBats</Transition>
		</State>
		
		<State id="ThrowOff">
