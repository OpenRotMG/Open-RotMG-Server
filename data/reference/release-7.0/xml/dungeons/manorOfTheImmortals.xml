				<Behavior type="auto" defaultAngle="0" numShots="24"  projectileId="1" cooldown="6" range="0" offset="1.8" angle="15" predictive="0">Shoot</Behavior>
				<Behavior type="auto" defaultAngle="8" numShots="24"  projectileId="1" cooldown="6" range="0" offset="2.2" angle="15" predictive="0">Shoot</Behavior>	
			</State>
			<State id='P3'>
				<Behavior tagName="p3done">SetTag</Behavior>
				<Behavior type="auto" defaultAngle="0" numShots="24"  projectileId="1" cooldown="6" range="0" offset="0.6" angle="15" predictive="0">Shoot</Behavior>
				<Behavior type="auto" defaultAngle="8" numShots="12"  projectileId="1" cooldown="6" range="0" offset="1" angle="30" predictive="0">Shoot</Behavior>
				<Behavior type="auto" defaultAngle="0" numShots="24"  projectileId="1" cooldown="6" range="0" offset="1.4" angle="15" predictive="0">Shoot</Behavior>
