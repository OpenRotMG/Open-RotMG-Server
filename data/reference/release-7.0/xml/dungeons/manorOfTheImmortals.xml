		<DefineEmbed name="healthCheck"> <!-- unused -->
			<State id="HealthCheck1">
				<!-- Behavior effect="Invincible">ConditionEffect</Behavior -->
				<Behavior tagName="p1">ClearTag</Behavior>
				<Behavior tagName="p2">ClearTag</Behavior>
				<Behavior tagName="p3">ClearTag</Behavior>
				<Behavior tagName="checking">SetTag</Behavior>
