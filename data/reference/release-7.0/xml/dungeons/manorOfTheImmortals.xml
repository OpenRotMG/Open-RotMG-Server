					<Transition hitpointsLessThan=".25">Four</Transition>
					<Transition hitpointsLessThan=".50">Three</Transition>
					<Transition hitpointsLessThan=".75">Two</Transition>
					<Transition hitpointsLessThan="1">One</Transition>
				</State>
				<State id="One">
					<Behavior tagName="p1">SetTag</Behavior>
					<Behavior tagName="checking">ClearTag</Behavior>
				</State>
				<State id="Two">
					<Behavior tagName="p2">SetTag</Behavior>
					<Behavior tagName="checking">ClearTag</Behavior>
				</State>
				<State id="Three">
					<Behavior tagName="p3">SetTag</Behavior>
					<Behavior tagName="checking">ClearTag</Behavior>
				</State>
				<State id="Four">
					<Behavior tagName="checking">ClearTag</Behavior>
				</State>
				<Transition hasTag="p3done">Choose</Transition>
				<Transition afterTime="0.2" noTag="checking">Choose</Transition>	
			</State>
			<Transition hasTag="p1" noTag="p1done" hitpointsLessThan=".75">ThrowOff</Transition>	
			<Transition hasTag="p2" noTag="p2done" hitpointsLessThan=".50">ThrowOff</Transition>	
			<Transition hasTag="p3" noTag="p3done" hitpointsLessThan=".25">ThrowOff</Transition>	
		</DefineEmbed>
		
		<DefineEmbed name="throwCoffins">
			<State id="ThrowCoffins">
				<Behavior effect="Invulnerable">ConditionEffect</Behavior>
				<State id="Position">
					<Behavior speed="1.3" range="0">StayCloseToSpawn</Behavior>
					<Transition afterTime="1">Shoot</Transition>
				</State>
				<State id="Shoot">
					<Behavior speed="1.3" range="0">StayCloseToSpawn</Behavior>
					<Behavior type="auto" childId="Coffin Creature" range="8.5" rangeJitter="0" defaultAngle="0" cooldown="5">ObjectToss</Behavior>
					<Behavior type="auto" childId="Coffin Creature" range="8.5" rangeJitter="0" defaultAngle="90" cooldown="5">ObjectToss</Behavior>
					<Behavior type="auto" childId="Coffin Creature" range="8.5" rangeJitter="0" defaultAngle="180" cooldown="5">ObjectToss</Behavior>
					<Behavior type="auto" childId="Coffin Creature" range="8.5" rangeJitter="0" defaultAngle="270" cooldown="5">ObjectToss</Behavior>
				</State>
				<Transition afterTime="1.2" hitpointsLessThan="0.68">DualSwarms</Transition>
				<Transition afterTime="1.2">TurnIntoBats</Transition>	
			</State>
		</DefineEmbed>
		
		<DefineEmbed name="daggers">
			<Behavior type="targeted" defaultAngle="0" numShots="{numShots}"  projectileId="0" cooldown="1.6" range="8" offset="0" angle="{angle}" predictive="1">Shoot</Behavior>
