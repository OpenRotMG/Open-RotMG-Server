				<Transition noTag="p2done">P2</Transition>	
				<Transition noTag="p3done">P3</Transition>
				<!--Transition hasTag="p1">P1</Transition-->	
				<!--Transition hasTag="p2">P2</Transition-->
				<!--Transition hasTag="p3">P3</Transition-->
			</State>
			<State id='P1'>
				<Behavior tagName="p1done">SetTag</Behavior>
				<Behavior type="auto" defaultAngle="0" numShots="24"  projectileId="1" cooldown="6" range="0" offset="1" angle="15" predictive="0">Shoot</Behavior>
				<Behavior type="auto" defaultAngle="8" numShots="24"  projectileId="1" cooldown="6" range="0" offset="1.8" angle="15" predictive="0">Shoot</Behavior>
			</State>
			<State id='P2'>
				<Behavior tagName="p2done">SetTag</Behavior>
