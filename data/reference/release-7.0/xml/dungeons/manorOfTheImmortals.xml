			<Behavior tagName="attackOver">ClearTag</Behavior>
			<Behavior maxSize="120" rate="100">ChangeSize</Behavior>
			<Order>
				<Behavior time="0" particleEffect="Nova" color="000000" dropLoot="false" giveXP="false">Decay</Behavior>
			</Order>
			<Transition afterTime="1">Regular</Transition>
		</State>
		
		
		<State id="DualSwarms">
			<State id="Position">
				<Behavior effect="Invulnerable">ConditionEffect</Behavior>
				<Behavior speed="1.25" range="0">StayCloseToSpawn</Behavior>
				<Transition afterTime="1.6">BatForms</Transition>
			</State>
			<State id="BatForms">
				<Behavior effect="Invincible">ConditionEffect</Behavior>
				<State id="Split">
					<Behavior minSize="0" rate="-100">ChangeSize</Behavior>
					<Behavior cooldown="0" childIds="Bat Swarm 1" maxChildren="1" startWithMinions="false">MakeMinions</Behavior>
					<Behavior cooldown="0" childIds="Bat Swarm 2" maxChildren="1" startWithMinions="false">MakeMinions</Behavior>
					<Transition afterTime="0.6">Part</Transition>
				</State>
				<State id="Part">
					<Behavior speed="2" distance="4" angle="180" cooldown="1">Move</Behavior>
					<Transition afterTime="1">Attack</Transition>
				</State>
				<State id="Attack">
					<Behavior bucket="movement" speed="2.4" range="15">StayCloseToSpawn</Behavior>
					<Behavior bucket="movement" speed="2" cooldown="0" range="12">Charge</Behavior>
					<Transition afterTime="10">Regroup</Transition>
				</State>
				<State id="Regroup">
					<Behavior speed="2" range="0">StayCloseToSpawn</Behavior>
					<Transition afterTime="1">Done</Transition>
				</State>
				<State id="Done">
					<Behavior speed="1.5" range="0">StayCloseToSpawn</Behavior>
					<Behavior tagName="attackOver">SetTag</Behavior>
				</State>
				<Behavior cooldown="0" childIds="Vampire Bat" maxChildren="10" startWithMinions="false">MakeMinions</Behavior>
			</State>
			
			<Transition afterTime="14" hasTag="attackOver">TurnBack</Transition>
		</State>
		
		<State id="Regular">
			<Behavior bucket="movement" speed=".3">Wander</Behavior>
			<Behavior speed=".3" range="4">StayCloseToSpawn</Behavior>
			
			<!--Embed name="healthCheck"></Embed-->
			
			<State id="Choose">
				<Transition hitpointsLessThan="0.25">Daggers4</Transition>
				<Transition hitpointsLessThan="0.50">Daggers3</Transition>
				<Transition hitpointsLessThan="0.75">Daggers2</Transition>
				<Transition random="1">Daggers1</Transition>
			</State>
			<State id="Daggers1">
				<Embed name="daggers">
					<Param name="numShots">3</Param>
					<Param name="angle">12</Param>
				</Embed>
			</State>
			<State id="Daggers2">
				<Embed name="daggers">
					<Param name="numShots">5</Param>
					<Param name="angle">15</Param>
				</Embed>
			</State>
			<State id="Daggers3">
