		<State id="start_the_fun">			
			<Behavior effect="Invulnerable">ConditionEffect</Behavior>
			<Transition playerWithin="11">he_is_never_alone</Transition>
			<Transition hitpointsLessThan="0.999">he_is_never_alone</Transition>	
		</State>
		<State id="he_is_never_alone">
			<Behavior childIds="Malphas Protector" cooldown="1" maxChildren="3" startWithMinions="false">MakeMinions</Behavior>
			<State id="Missile_Fire">
				<Behavior bucket="movement" range="5" speed="0.3">StayCloseToSpawn</Behavior>
				<Behavior bucket="movement" acquireRange="8" range="2" speed="0.3">Follow</Behavior>

				<Behavior numShots="1" projectileId="0" cooldown="0.9" type="targeted" offset="1" predictive="0.15">Shoot</Behavior>
				<Behavior childIds="Malphas Missile" cooldown="1.8" maxChildren="4" startWithMinions="false">MakeMinions</Behavior>

				<State id="invulnerable1">
					<Behavior effect="Invulnerable">ConditionEffect</Behavior>
					<Transition afterTime="2">vulnerable</Transition>
				</State>			
				<State id="vulnerable">
					<Transition afterTime="4">invulnerable2</Transition>
				</State>
				<State id="invulnerable2">
					<Behavior effect="Invulnerable">ConditionEffect</Behavior>
				</State>

				<Transition afterTime="9">Pause1</Transition>						
			</State>
			<State id="Pause1">
				<Behavior effect="Invulnerable">ConditionEffect</Behavior>

       				<Behavior bucket="movement" range="5" speed="0.4">StayCloseToSpawn</Behavior>
       				<Behavior bucket="movement" speed="0.4">Wander</Behavior>

				<Transition afterTime="2.5">Small_target</Transition>						
			</State>		
			<State id="Small_target">
       				<Behavior bucket="movement" range="5" speed="0.8">StayCloseToSpawn</Behavior>
       				<Behavior bucket="movement" speed="0.8">Wander</Behavior>		

				<Behavior rate="-11" minSize="30">ChangeSize</Behavior>
				<Behavior numShots="6" projectileId="2" cooldown="1.2" type="auto" angle="60">Shoot</Behavior>
				<Behavior numShots="1" projectileId="0" cooldown="0.9" type="targeted" offset="0.6" predictive="0.15">Shoot</Behavior>

				<Transition afterTime="12">Size_matters</Transition>						
			</State>
			<State id="Size_matters">
       				<Behavior bucket="movement" range="5" speed="0.2">StayCloseToSpawn</Behavior>
       				<Behavior bucket="movement" speed="0.2">Wander</Behavior>

				<State id="Growbig">
					<Behavior rate="11" maxSize="140">ChangeSize</Behavior>
					<Behavior effect="Invulnerable">ConditionEffect</Behavior>
					<Transition afterTime="1.8">Shot_rotation1</Transition>	
				</State>
				<State id="Shot_rotation1">
					<Behavior effect="Invulnerable">ConditionEffect</Behavior>

					<Behavior numShots="1" projectileId="3" cooldown="0.9" type="targeted" predictive="0.2">Shoot</Behavior>
					<Behavior numShots="3" projectileId="4" cooldown="0.7" offset="0.7" type="auto" angle="120" defaultAngle="0">Shoot</Behavior>
					<Transition afterTime="1.4">Shot_rotation2</Transition>	
				</State>
				<State id="Shot_rotation2">
					<Behavior numShots="1" projectileId="3" cooldown="0.9" type="targeted" predictive="0.2">Shoot</Behavior>
					<Behavior numShots="1" projectileId="3" cooldown="2" type="targeted" predictive="0.25">Shoot</Behavior>
					<Behavior numShots="3" projectileId="4" cooldown="0.7" offset="0.7" type="auto" angle="120" defaultAngle="40">Shoot</Behavior>
					<Transition afterTime="1.4">Shot_rotation3</Transition>	
				</State>
				<State id="Shot_rotation3">
					<Behavior effect="Invulnerable">ConditionEffect</Behavior>

					<Behavior numShots="1" projectileId="3" cooldown="0.9" type="targeted" predictive="0.2">Shoot</Behavior>
					<Behavior numShots="3" projectileId="4" cooldown="0.7" offset="0.7" type="auto" angle="120" defaultAngle="80">Shoot</Behavior>

					<Transition afterTime="1.4">Shot_rotation1</Transition>	
				</State>			
				<Transition afterTime="13">Pause2</Transition>
			</State>
			<State id="Pause2">
				<Behavior rate="-11" minSize="100">ChangeSize</Behavior>
				<Behavior effect="Invulnerable">ConditionEffect</Behavior>

       				<Behavior bucket="movement" range="5" speed="0.4">StayCloseToSpawn</Behavior>
       				<Behavior bucket="movement" speed="0.4">Wander</Behavior>

				<Transition afterTime="2.5">Bring_on_the_flamers</Transition>						
			</State>		
			<State id="Bring_on_the_flamers">
					<Behavior rate="14" maxSize="100">ChangeSize</Behavior>
					<Behavior effect="Invulnerable">ConditionEffect</Behavior>

					<Behavior bucket="movement" range="5" speed="0.4">StayCloseToSpawn</Behavior>
					<Behavior bucket="movement" acquireRange="9" range="2" speed="0.4">Follow</Behavior>

					<Behavior numShots="1" projectileId="0" cooldown="2.1" type="targeted" predictive="0.25">Shoot</Behavior>
					<Behavior childIds="Malphas Flamer" cooldown="0.5" maxChildren="5" startWithMinions="false">MakeMinions</Behavior>
					<Behavior childId="Malphas Flamer" cooldown="9" type="auto" range="6" defaultAngle="0">ObjectToss</Behavior>
					<Behavior childId="Malphas Flamer" cooldown="9" type="auto" range="6" defaultAngle="90">ObjectToss</Behavior>
					<Behavior childId="Malphas Flamer" cooldown="9" type="auto" range="6" defaultAngle="180">ObjectToss</Behavior>
					<Behavior childId="Malphas Flamer" cooldown="9" type="auto" range="6" defaultAngle="270">ObjectToss</Behavior>
					
					<Transition afterTime="8">Temporary_exhaustion</Transition>
			</State>
			<State id="Temporary_exhaustion">
				<Behavior type="Flash" color="484848" flashPeriod="0.6" flashRepeats="5">ShowEffect</Behavior>
				<Behavior distance="5" speed="0.4">StayBack</Behavior>
				
				<Transition afterTime="3.2">Missile_Fire</Transition>
			</State>
		</State>
		
		<Behavior prob="1" childId="Archdemon SafeGround">MetamorphoseAtDeath</Behavior>
	</Object>	

