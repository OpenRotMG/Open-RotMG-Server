		<State id="start_the_fun">			
			<Behavior effect="Invulnerable">ConditionEffect</Behavior>
			<Transition playerWithin="11">begin_teleport1</Transition>
			<Transition hitpointsLessThan="0.999">begin_teleport1</Transition>					
		</State>	
		<State id="begin_teleport1">
			<Behavior effect="Invulnerable">ConditionEffect</Behavior>
			<Behavior bucket="movement" range="7" speed="0.5" cooldown="0">StayCloseToSpawn</Behavior>
			<Behavior bucket="movement" speed="0.5">Wander</Behavior>			
			<Behavior type="Flash" color="00FF00" flashPeriod="0.25" flashRepeats="8">ShowEffect</Behavior>
			<Transition afterTime="2">teleport1</Transition>
		</State>
		<State id="teleport1">
			<Behavior bucket="movement" range="7" speed="1.6" cooldown="0">StayCloseToSpawn</Behavior>
			<Behavior bucket="movement" acquireRange="10" range="2" speed="6">Follow</Behavior>
			<Behavior bucket="movement" acquireRange="10" range="0.2" speed="0.3">Follow</Behavior>
			<Transition afterTime="0.3">circle_player</Transition>
		</State>
		<State id="circle_player">
			<Behavior numShots="2" projectileId="0" cooldown="0.4" type="targeted" predictive="0.4" angle="10" offset="0.7">Shoot</Behavior>
			<Behavior numShots="2" projectileId="0" cooldown="0.4" type="targeted" predictive="0.4" angle="180" offset="0.7">Shoot</Behavior>
			
			<Behavior bucket="movement" range="7" speed="1.3" cooldown="0">StayCloseToSpawn</Behavior>
			<Behavior bucket="movement" acquireRange="5" distance="4" speed="1.8">Circle</Behavior>
			<Behavior bucket="movement" acquireRange="10" range="2" speed="6">Follow</Behavior>
			<Behavior bucket="movement" acquireRange="10" range="0.2" speed="0.3">Follow</Behavior>
			<Behavior bucket="movement" numShots="18" projectileId="0" cooldown="1.5" type="auto" angle="20" offset="0.4">Shoot</Behavior>

			<State id="unshielded">
				<Transition afterTime="1.5">shielded</Transition>
			</State>
			<State id="shielded">
				<Behavior effect="Invulnerable">ConditionEffect</Behavior>
				<Transition afterTime="3.5">unshielded</Transition>
			</State>
			
			<Transition afterTime="10">set_up_the_box</Transition>
		</State>	
		<State id="set_up_the_box">
			<Behavior childId="Limon Element 1" cooldown="10000" type="auto" defaultAngle="315" range="9.5">ObjectToss</Behavior>
			<Behavior childId="Limon Element 2" cooldown="10000" type="auto" defaultAngle="225" range="9.5">ObjectToss</Behavior>
			<Behavior childId="Limon Element 3" cooldown="10000" type="auto" defaultAngle="135" range="9.5">ObjectToss</Behavior>
			<Behavior childId="Limon Element 4" cooldown="10000" type="auto" defaultAngle="45" range="9.5">ObjectToss</Behavior>

			<Behavior childId="Limon Element 1" cooldown="10000" type="auto" defaultAngle="315" range="14">ObjectToss</Behavior>
			<Behavior childId="Limon Element 2" cooldown="10000" type="auto" defaultAngle="225" range="14">ObjectToss</Behavior>
			<Behavior childId="Limon Element 3" cooldown="10000" type="auto" defaultAngle="135" range="14">ObjectToss</Behavior>
			<Behavior childId="Limon Element 4" cooldown="10000" type="auto" defaultAngle="45" range="14">ObjectToss</Behavior>

			<State id="shielded1">
				<Behavior numShots="1" projectileId="0" cooldown="1" type="targeted" predictive="0.1">Shoot</Behavior>
				<Behavior numShots="3" projectileId="0" cooldown="0.5" type="targeted" predictive="0.1" angle="120" offset="0.3">Shoot</Behavior>
				<Transition afterTime="1.5">shielded2</Transition>
			</State>
			<State id="shielded2">
				<Behavior effect="Invulnerable">ConditionEffect</Behavior>
				<Behavior numShots="3" projectileId="0" cooldown="0.8" type="targeted" predictive="0.2" angle="120" offset="0.3">Shoot</Behavior>
				<Transition afterTime="3.5">shielded1</Transition>
			</State>

			<Transition afterTime="20">Summon_the_sprites</Transition>
		</State>		
		<State id="Summon_the_sprites">
			<Behavior bucket="movement" range="8" speed="0.5" cooldown="0">StayCloseToSpawn</Behavior>
			<Behavior bucket="movement" speed="0.5">Wander</Behavior>
			
			<Behavior effect="Armored">ConditionEffect</Behavior>
			
			<Behavior numShots="3" projectileId="0" cooldown="1.3" type="targeted" angle="15">Shoot</Behavior>
			<Behavior childIds="Magic Sprite" cooldown="0.5" maxChildren="2" startWithMinions="false">MakeMinions</Behavior>
			<Behavior childIds="Ice Sprite" cooldown="0.5" maxChildren="1" startWithMinions="false">MakeMinions</Behavior>

			<Transition afterTime="11">begin_teleport1</Transition>
			<Transition hitpointsLessThan="0.2">begin_teleport1</Transition>
		</State>
		
		<Behavior prob="1" childId="Glowing Realm Portal">MetamorphoseAtDeath</Behavior>
	</Object>

