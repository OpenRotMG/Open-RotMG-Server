    <Object type="0xCHANGE" id="Altar of Nightmares">
        <Enemy/>
        <Class>Character</Class>
        <RemoteTexture><Instance>testing</Instance><Id>11849117</Id></RemoteTexture>
        <AltTexture id="1">
            <RemoteTexture><Instance>testing</Instance><Id>11839314</Id></RemoteTexture>
        </AltTexture>
        <AltTexture id="2">
            <RemoteTexture><Instance>testing</Instance><Id>11851068</Id></RemoteTexture>
        </AltTexture>
        <!--<AltTexture id="3">-->
        <RemoteTexture><Instance>testing</Instance><Id>11840345</Id></RemoteTexture>
        <HitSound>monster/skeletons_hit</HitSound>
        <DeathSound>monster/skeletons_death</DeathSound>
        <Size>100</Size>
        <MaxHitPoints>10000</MaxHitPoints>
        <Defense>50</Defense>
        <ShadowSize>200</ShadowSize>
        <XpMult>2.0</XpMult>
        <OccupySquare/>

        <State id="Wait">
            <Behavior text="Pray at this shrine by focusing your destructive tendencies!">Say</Behavior>
            <Transition hitpointsLessThan="0.85">Cracked</Transition>
            <Transition hitpointsLessThan="0.50">Broken</Transition>
            <Transition hitpointsLessThan="0.15">Rubble</Transition>
        </State>
        <State id="Cracked">
            <Behavior altTextureId="1">SetAltTexture</Behavior>
            <Transition hitpointsLessThan="0.50">Broken</Transition>
            <Transition hitpointsLessThan="0.15">Rubble</Transition>
        </State>
        <State id="Broken">
            <Behavior altTextureId="2">SetAltTexture</Behavior>
            <Transition hitpointsLessThan="0.15">Rubble</Transition>
        </State>
        <State id="Rubble">
            <Behavior effect="Stasis Immune">ConditionEffect</Behavior>
            <Behavior altTextureId="3">SetAltTexture</Behavior>
        </State>

        <Behavior childId="Nightmare Presenter">MetamorphoseAtDeath</Behavior>
    </Object>

    <Object type="0xCHANGE" id="DreamTransition">
        <DisplayId>The Dreameater</DisplayId>
        <Enemy/>
        <Class>Character</Class>
        <RemoteTexture><Instance>testing</Instance><Id>11851051</Id></RemoteTexture>
        <AltTexture id="1">
            <RemoteTexture><Instance>testing</Instance><Id>11826842</Id></RemoteTexture>
        </AltTexture>
        <AltTexture id="2">
            <RemoteTexture><Instance>testing</Instance><Id>11838393</Id></RemoteTexture>
        </AltTexture>
        <AltTexture id="3">
            <RemoteTexture><Instance>testing</Instance><Id>11838398</Id></RemoteTexture>
