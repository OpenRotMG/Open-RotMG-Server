    *********************************************************************************
    -->
    <Object type="0x099b" id="Jeebs">
        <Class>Character</Class>
        <Group>Mad Lab</Group>
        <RemoteTexture><Instance>testing</Instance><Id>7632526</Id><Right/></RemoteTexture>

        <HitSound>monster/slimes_death</HitSound>
        <DeathSound>monster/flying_brain_death</DeathSound>
        <Size>200</Size>
        <ShadowSize>50</ShadowSize>
        <Defense>10</Defense>

        <State id="Ini">
            <Behavior prob="1" bubbleTime="3" text="Hello! I'm Jeebs.Ask me questions and I'll answer them if I can.">Say</Behavior>
            <Transition afterTime="2">Listening</Transition>
        </State>

        <State id="Listening">
            <Transition playerSays="Boosh">AnswerBoosh</Transition>
            <Transition playerSays="how to get to oryx">AnswerOryxLair</Transition>
            <Transition playerSays="pets">AnswerPets</Transition>
            <Transition playerSays="vaults">AnswerVault</Transition>
            <Transition playerSays="Thessal">AnswerThessal</Transition>
            <Transition playerSays="how to create guild">AnswerCreateGuild</Transition>
            <Transition playerSays="how to join guild">AnswerJoinGuild</Transition>
        </State>

        <State id="AnswerBoosh">
            <Behavior prob="1" bubbleTime="3" text="Boosh is a developer for ROTMG.">Say</Behavior>
            <Transition afterTime="2">Listening</Transition>
        </State>

        <State id="AnswerOryxLair">
            <Behavior prob="1" bubbleTime="3" text="In order to enter Oryx's Lair you need to slay enough monsters in a realm. This will anger Oryx and he will summon you to his lair.">Say</Behavior>
            <Transition afterTime="2">Listening</Transition>
        </State>

        <State id="AnswerPets">
            <Behavior prob="1" bubbleTime="3" text="Pets are cosmetic creatures that will daringly follow you around wherever you go. They cannot be hurt, but make sure not to die with them or they will be lost.">Say</Behavior>
            <Transition afterTime="2">Listening</Transition>
        </State>

        <State id="AnswerVault">
            <Behavior prob="1" bubbleTime="3" text="Vaults are a great way to store your treasures for safe keeping. If your character dies, the items in your vault will remain safe for your next character.">Say</Behavior>
            <Transition afterTime="2">Listening</Transition>
        </State>

        <State id="AnswerThessal">
            <Behavior prob="1" bubbleTime="3" text="Quite the beauty but she is also dangerous at close range.">Say</Behavior>
            <Transition afterTime="2">Listening</Transition>
        </State>

        <State id="AnswerCreateGuild">
            <Behavior prob="1" bubbleTime="3" text="You can create your own guild by spending 1000 Fame at the Guild Charter in the Nexus. Once created you can invite other players.">Say</Behavior>
            <Transition afterTime="2">Listening</Transition>
        </State>

        <State id="AnswerJoinGuild">
            <Behavior prob="1" bubbleTime="3" text="You can join a guild by having a member of that guild invite you.">Say</Behavior>
            <Transition afterTime="2">Listening</Transition>
        </State>

    </Object>

