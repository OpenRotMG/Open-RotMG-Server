        <DeathSound>monster/skeletons_death</DeathSound>
        <Size>400</Size>
        <MaxHitPoints>100000</MaxHitPoints>
        <Defense>25</Defense>
        <XpMult>5.0</XpMult>
        <DrawOnGround/>

        <Projectile id="0">
            <ObjectId>White Bullet</ObjectId>
            <Damage>100</Damage>
            <Speed>120</Speed>
            <Size>200</Size>
            <LifetimeMS>2000</LifetimeMS>
            <MultiHit/>
            <ConditionEffect duration="0">Armor Pierce</ConditionEffect>
        </Projectile>

        <State id="Talk">
            <Behavior effect="Invulnerable">ConditionEffect</Behavior>
            <Behavior effect="Stasis Immune">ConditionEffect</Behavior>
            <Behavior effect="Stun Immune">ConditionEffect</Behavior>

            <Behavior text="RUN!!">Say</Behavior>
            <Transition afterTime="1">Spew1</Transition>
        </State>

        <State id="Spew1">
            <Behavior effect="Invulnerable">ConditionEffect</Behavior>
            <Behavior effect="Stasis Immune">ConditionEffect</Behavior>
            <Behavior effect="Stun Immune">ConditionEffect</Behavior>

            <Behavior projectileId="0" numShots="25" type="auto" range="20" angle="14" cooldown="1.5" defaultAngle="90" offset="0.4">Shoot</Behavior>
            <Behavior childIds="The Dreameater2" cooldown="360000" maxChildren="1" startWithMinions="false">MakeMinions</Behavior>
            <Behavior bucket="movement" protecteeId="Corner1" protectionRange="0.2" speed="0.6" acquireRange="40">Protect</Behavior>
            <Transition afterTime="1">Spew2</Transition>
        </State>
        <State id="Spew2">
            <Behavior effect="Invulnerable">ConditionEffect</Behavior>
            <Behavior effect="Stasis Immune">ConditionEffect</Behavior>
            <Behavior effect="Stun Immune">ConditionEffect</Behavior>

            <Behavior projectileId="0" numShots="25" type="auto" range="20" angle="14" cooldown="1.5" defaultAngle="90" offset="0.4">Shoot</Behavior>
            <Behavior childIds="The Dreameater3" cooldown="360000" maxChildren="1" startWithMinions="false">MakeMinions</Behavior>
            <Behavior bucket="movement" protecteeId="Corner1" protectionRange="0.2" speed="0.7" acquireRange="40">Protect</Behavior>
            <Transition afterTime="1">Spew3</Transition>
        </State>
        <State id="Spew3">
            <Behavior effect="Invulnerable">ConditionEffect</Behavior>
            <Behavior effect="Stasis Immune">ConditionEffect</Behavior>
            <Behavior effect="Stun Immune">ConditionEffect</Behavior>

            <Behavior projectileId="0" numShots="25" type="auto" range="20" angle="14" cooldown="1.5" defaultAngle="90" offset="0.4">Shoot</Behavior>
            <Behavior childIds="The Dreameater4" cooldown="360000" maxChildren="1" startWithMinions="false">MakeMinions</Behavior>
            <Behavior bucket="movement" protecteeId="Corner1" protectionRange="0.2" speed="0.8" acquireRange="40">Protect</Behavior>
            <Transition afterTime="1">Corner1</Transition>
        </State>

        <State id="Corner1">
            <Behavior bucket="movement" protecteeId="Corner1" protectionRange="0.2" speed="1.0" acquireRange="40">Protect</Behavior>

            <Order targetIds="Corner1">
                <Behavior time="0.2" childId="Corner0">Metamorphose</Behavior>
            </Order>

            <Transition noneExist="Corner1">Corner2</Transition>

        </State>

        <State id="Corner2">
            <Behavior bucket="movement" protecteeId="Corner2" protectionRange="0.2" speed="1.0" acquireRange="40">Protect</Behavior>

            <Order targetIds="Corner2">
                <Behavior time="0.2" childId="Corner1">Metamorphose</Behavior>
            </Order>

            <Transition noneExist="Corner2">Corner3</Transition>

        </State>

        <State id="Corner3">
            <Behavior bucket="movement" protecteeId="Corner3" protectionRange="0.2" speed="1.0" acquireRange="40">Protect</Behavior>

            <Order targetIds="Corner3">
                <Behavior time="0.2" childId="Corner2">Metamorphose</Behavior>
            </Order>

            <Transition noneExist="Corner3">Corner4</Transition>

        </State>

        <State id="Corner4">
            <Behavior bucket="movement" protecteeId="Corner4" protectionRange="0.2" speed="1.4" acquireRange="40">Protect</Behavior>

            <Order targetIds="Corner4">
                <Behavior time="0.2" childId="Corner3">Metamorphose</Behavior>
            </Order>

            <Transition noneExist="Corner4">Corner0</Transition>

        </State>


        <State id="Corner0">
            <Behavior bucket="movement" protecteeId="Corner0" protectionRange="0.2" speed="0.8" acquireRange="40">Protect</Behavior>

            <Order targetIds="Corner0">
                <Behavior time="0.2" childId="Corner4">Metamorphose</Behavior>
            </Order>

            <Transition noneExist="Corner0">Corner1</Transition>

        </State>

    </Object>


