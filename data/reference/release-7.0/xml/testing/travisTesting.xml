    <!--
    *********************************************************************************

    Tinctures of Fear and Courage

    Boss gives out speed enhancing but attack lowering potions (fear) for those that may use them strategically
    Dungeon minions give out attack strengthening but speed lowering (courage) for those that take time to kill
        minions to then help them achieve soulbound on the boss

    *********************************************************************************
    -->

    <Object type="0xCHANGE" id="Tincture of Fear">
        <Class>Equipment</Class>
        <Item/>
        <Texture><File>lofiObj2</File><Index>0xc7</Index></Texture>
        <SlotType>10</SlotType>
        <Description>Adds speed and reduces attack.</Description>
        <Sound>use_potion</Sound>
        <Consumable/>
        <Soulbound/>
        <Potion/>
        <BagType>3</BagType>
        <Activate stat="22" amount="15" duration="45">StatBoostSelf</Activate>
        <Activate stat="20" amount="-15" duration="60">StatBoostSelf</Activate>
    </Object>

    <Object type="0xCHANGE" id="Tincture of Courage">
        <Class>Equipment</Class>
        <Item/>
        <Texture><File>lofiObj2</File><Index>0xc7</Index></Texture>
        <SlotType>10</SlotType>
        <Description>Adds attack to everyone reduces speed for self.</Description>
        <Sound>use_potion</Sound>
        <Consumable/>
        <Soulbound/>
        <Potion/>
        <BagType>3</BagType>
        <Activate stat="22" amount="-10" duration="30">StatBoostSelf</Activate>
        <Activate stat="20" amount="15" duration="30">StatBoostSelf</Activate>
    </Object>

