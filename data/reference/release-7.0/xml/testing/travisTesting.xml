        <Behavior effect="Invincible">ConditionEffect</Behavior>

        <State id="Talk1">
            <Behavior childId="Gift of Fear" cooldown="6000" offset="0.4" type="auto" range="3" defaultAngle="225">ObjectToss</Behavior>
            <Behavior childId="Gift of Fear" cooldown="6000" offset="0.6" type="auto" range="3" defaultAngle="220">ObjectToss</Behavior>
            <Behavior childId="Gift of Fear" cooldown="6000" offset="0.6" type="auto" range="3" defaultAngle="230">ObjectToss</Behavior>
            <Behavior text="Ah yes, I sense it in you! Fear! Take these to help you tap into this emotion.">Say</Behavior>
            <Transition afterTime="2">Blend</Transition>
        </State>
        <State id="Blend">
            <Behavior altTextureId="1">SetAltTexture</Behavior>
            <Transition afterTime="0.6">Talk2</Transition>
        </State>
        <State id="Talk2">
            <Behavior text="Fear me...">Say</Behavior>
            <Behavior altTextureId="2">SetAltTexture</Behavior>
            <Transition afterTime="0.6">Fear</Transition>
        </State>
        <State id="Fear">
            <Behavior text="...and...">Say</Behavior>
            <Behavior altTextureId="3">SetAltTexture</Behavior>
            <Behavior time="0.8" childId="The Dreameater1">Metamorphose</Behavior>
        </State>
    </Object>


