    <Object type="0xCHANGE" id="The Dreameater1">
        <DisplayId>The Dreameater</DisplayId>
        <Group>Dreameater Sections</Group>
        <Enemy/>
        <Class>Character</Class>
        <RemoteTexture><Instance>testing</Instance><Id>11844260</Id></RemoteTexture>
