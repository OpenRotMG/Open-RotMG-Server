    <Object type="0x5e9f" id="Arena Headless Horseman">
        <DisplayId>Headless Horseman</DisplayId>
        <Class>Character</Class>
        <Enemy/>

        <RemoteTexture><Instance>testing</Instance><Id>9225527</Id><Right/></RemoteTexture>

        <HitSound>monster/slimes_death</HitSound>
        <DeathSound>monster/flying_brain_death</DeathSound>
        <Size>150</Size>
        <ShadowSize>100</ShadowSize>
        <MaxHitPoints>2500</MaxHitPoints>
        <Defense>20</Defense>

        <Projectile id="0">
            <ObjectId>Orange Pumpkin Blast</ObjectId>
            <Damage>55</Damage>
            <Speed>80</Speed>
            <LifetimeMS>2000</LifetimeMS>
            <Size>175</Size>
        </Projectile>

        <Projectile id="1">
            <ObjectId>Orange Shot</ObjectId>
            <Damage>55</Damage>
            <Speed>80</Speed>
            <LifetimeMS>1500</LifetimeMS>
            <Size>225</Size>
        </Projectile>

        <!--<WhileMoving>-->
            <!--<Z>0.7</Z>-->
            <!--<Flying/>-->
        <!--</WhileMoving>-->

        <State id="Ini">
            <Behavior speed=".5">Wander</Behavior>
            <Transition playerWithin="6">Phase1</Transition>
        </State>

        <State id="Phase1">
            <State id="SpawnAnchor">
                <Behavior cooldown="50" childIds="Arena Horseman Anchor" maxChildren="1">MakeMinions</Behavior>
                <Transition afterTime="1">CircleAttack</Transition>
            </State>
            <State id="CircleAttack">
                <Behavior protecteeId="Arena Horseman Anchor" acquireRange="10" speed="1.8" radius="5">Orbit</Behavior>
                <Behavior type="targeted" defaultAngle="0" angle="45" numShots="3"  projectileId="0" cooldown="1" range="6" offset="0" predictive="0">Shoot</Behavior>
                <Transition afterTime="5">ChargeAttack</Transition>
            </State>
            <State id="ChargeAttack">
                <Behavior cooldown="3" speed="2" range="6">Charge</Behavior>
                <Behavior protecteeId="Arena Horseman Anchor" acquireRange="10" speed="1.3" radius="5">Orbit</Behavior>
                <Behavior type="targeted" defaultAngle="0" numShots="1"  projectileId="1" cooldown="1" range="6" offset="0" predictive="0">Shoot</Behavior>
                <Transition afterTime="5">CircleAttack</Transition>
            </State>

            <Transition hitpointsLessThan=".8">Phase2</Transition>
        </State>

        <State id="Phase2">
            <Behavior prob="1" text="Phase 2">Say</Behavior>
            <State id="Split">

            </State>
        </State>
    </Object>

