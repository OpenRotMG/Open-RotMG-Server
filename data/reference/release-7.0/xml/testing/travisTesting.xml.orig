    <Object type="0x5f23" id="Area 4 Controller">
        <DisplayId>Arena Master</DisplayId>
        <Class>Character</Class>
        <Enemy/>
        <Texture><File>invisible</File><Index>0</Index></Texture>

        <AltTexture id="1">
            <RemoteTexture><Instance>testing</Instance><Id>10308127</Id><Right/></RemoteTexture>
        </AltTexture>

        <NoMiniMap/>
        <MaxHitPoints>10</MaxHitPoints>
        <Behavior effect="Invincible">ConditionEffect</Behavior>
        <Size>125</Size>
        <ShadowSize>0</ShadowSize>

        <State id="Ini">
            <Behavior tagName="Wave5Next">ClearGlobalTag</Behavior>
            <Behavior tagName="Wave5Active">ClearGlobalTag</Behavior>
            <Behavior tagName="Wave1Next">SetGlobalTag</Behavior>
            <Behavior tagName="Area4Active">SetGlobalTag</Behavior>
            <Transition afterTime="1">Listening</Transition>
        </State>

        <State id="Listening">
            <Behavior altTextureId="1">SetAltTexture</Behavior>
            <Behavior prob="1" text="Say, 'Ready' when you are ready to face your opponents" bubbleTime="2">Say</Behavior>
            <Transition playerSays="Ready" noneExist="Hallowrena">CheckWave</Transition>
        </State>

        <State id="Countdown">
            <Behavior altTextureId="1">SetAltTexture</Behavior>
            <Behavior prob="1" text="The next wave will appear in 10 seconds. Prepare yourself!; The next onslaught will begin in 10 seconds!; You have 10 seconds until your next challenge!" bubbleTime="4">Say</Behavior>
            <Transition afterTime="10" noneExist="Hallowrena">CheckWave</Transition>
        </State>

        <State id="CheckWave">
            <!--Start from last wave and work to 1-->
            <!--<Behavior prob="1" text="Checking Wave">Say</Behavior>-->
            <Transition hasGlobalTag="Wave5Next">Wave5Start</Transition>
            <Transition hasGlobalTag="Wave4Next">Wave4Start</Transition>
            <Transition hasGlobalTag="Wave3Next">Wave3Start</Transition>
            <Transition hasGlobalTag="Wave2Next">Wave2Start</Transition>
            <Transition hasGlobalTag="Wave1Next">Wave1Start</Transition>
        </State>

        <State id="Wave1Start">
            <!--<Behavior prob="1" text="Wave 1 Start">Say</Behavior>-->
            <Behavior tagName="Wave1Active">SetGlobalTag</Behavior>
            <Transition afterTime="1">Round1Active</Transition>
        </State>

        <State id="Wave2Start">
            <Behavior tagName="Wave2Active">SetGlobalTag</Behavior>
            <Transition afterTime="1">Round2Active</Transition>
        </State>

        <State id="Wave3Start">
            <Behavior tagName="Wave3Active">SetGlobalTag</Behavior>
            <Transition afterTime="1">Round3Active</Transition>
        </State>

        <State id="Wave4Start">
            <Behavior tagName="Wave4Active">SetGlobalTag</Behavior>
            <Transition afterTime="1">Round4Active</Transition>
        </State>

        <State id="Wave5Start">
            <Behavior tagName="Wave5Active">SetGlobalTag</Behavior>
            <Transition afterTime="1">Round5Active</Transition>
        </State>

        <State id="Round1Active">
            <!--<Behavior prob="1" text="Round 1 Active">Say</Behavior>-->
            <Transition noneExist="Hallowrena">SetNextWave</Transition>
        </State>

        <State id="Round2Active">
            <Transition noneExist="Hallowrena">SetNextWave</Transition>
        </State>

        <State id="Round3Active">
            <Transition noneExist="Hallowrena">SetNextWave</Transition>
        </State>

        <State id="Round4Active">
            <Transition noneExist="Hallowrena">SetNextWave</Transition>
        </State>

        <State id="Round5Active">
            <Behavior tagName="Wave5Active">ClearGlobalTag</Behavior>
            <Transition noneExist="Hallowrena">SetNextWave</Transition>
        </State>

        <State id="SetNextWave">
            <!--<Behavior prob="1" text="Entering SetNextWave">Say</Behavior>-->
            <State id="DetermineCurrentWave">
                <!--Needs to go from 1 to 2 to 3 and so on-->
                <!--<Behavior prob="1" text="Determining Current Wave">Say</Behavior>-->
                <Transition hasGlobalTag="Wave1Next">ClearWave1SetWave2</Transition>
                <Transition hasGlobalTag="Wave2Next">ClearWave2SetWave3</Transition>
                <Transition hasGlobalTag="Wave3Next">ClearWave3SetWave4</Transition>
                <Transition hasGlobalTag="Wave4Next">ClearWave4SetWave5</Transition>
                <Transition hasGlobalTag="Wave5Next">IncrementArea</Transition>
            </State>
            <State id="ClearWave1SetWave2">
                <!--Clear current wave tag and set the next one-->
                <!--<Behavior prob="1" text="Clear Wave 1 Set Wave 2">Say</Behavior>-->
                <Behavior tagName="Wave1Next">ClearGlobalTag</Behavior>
                <Behavior tagName="Wave1Active">ClearGlobalTag</Behavior>
                <Behavior tagName="Wave2Next">SetGlobalTag</Behavior>
            </State>
            <State id="ClearWave2SetWave3">
                <!--Clear current wave tag and set the next one-->
                <!--<Behavior prob="1" text="Clear Wave 2 Set Wave 3">Say</Behavior>-->
                <Behavior tagName="Wave2Next">ClearGlobalTag</Behavior>
                <Behavior tagName="Wave2Active">ClearGlobalTag</Behavior>
                <Behavior tagName="Wave3Next">SetGlobalTag</Behavior>
            </State>
            <State id="ClearWave3SetWave4">
                <!--Clear current wave tag and set the next one-->
                <!--<Behavior prob="1" text="Clear Wave 3 Set Wave 4">Say</Behavior>-->
                <Behavior tagName="Wave3Next">ClearGlobalTag</Behavior>
                <Behavior tagName="Wave3Active">ClearGlobalTag</Behavior>
                <Behavior tagName="Wave4Next">SetGlobalTag</Behavior>
            </State>
            <State id="ClearWave4SetWave5">
                <!--Clear current wave tag and set the next one-->
                <!--<Behavior prob="1" text="Clear Wave 4 Set Wave 5">Say</Behavior>-->
                <Behavior tagName="Wave4Next">ClearGlobalTag</Behavior>
                <Behavior tagName="Wave4Active">ClearGlobalTag</Behavior>
                <Behavior tagName="Wave5Next">SetGlobalTag</Behavior>
            </State>
            <State id="IncrementArea">
                <!--<Behavior prob="1" text="Incrementing Area and should be dead">Say</Behavior>-->
                <Behavior tagName="Area5Active">ClearGlobalTag</Behavior>
                <Behavior tagName="Wave5Next">ClearGlobalTag</Behavior>
                <Transition afterTime="0.5">Decay</Transition>
            </State>
            <State id="Decay">
                <Behavior time="0">Decay</Behavior>
            </State>
            <Transition afterTime="2">Countdown</Transition>
        </State>
        <!--<Behavior prob="1" childId="Area5 Portal">MetamorphoseAtDeath</Behavior>-->

    </Object>

