        <State id="AttackPlayer">
            <Behavior cooldown="3" speed="6" range="9">Charge</Behavior>
            <Transition playerWithin="1">Explode</Transition>
            <Transition playerWithin="4">Follow</Transition>
        </State>

        <State id="Follow">
            <Behavior acquireRange="6" range=".5" speed="1.4" duration="10" cooldown="2" predictive="true">Follow</Behavior>
            <Transition playerWithin="1">Explode</Transition>
        </State>

        <State id="Explode">
            <Behavior initialDelay="0" range="0.0" numShots="10" arcDegrees="360" projectileId="0" dropLoot="false" giveXP="false">Explode</Behavior>
        </State>
