				<Transition afterTime="0.6" random=".1">Change</Transition> 
			</State>
			<State id="Change">
				<Transition afterTime="0">Go</Transition>
			</State>
		</State>
		
		<DefineEmbed name="commands">
			<Transition playerSays="Wander">Wander</Transition>
			<Transition playerSays="Follow">Follow</Transition>
			<Transition playerSays="Dance">Dance</Transition>
			<Transition playerSays="Talk">Talk</Transition>
