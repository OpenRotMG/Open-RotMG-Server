	<Object type="0x0953" id="Bandit Leader">
		<Group>Bandits</Group>
		<Enemy/>
		<Class>Character</Class>
		<AnimatedTexture><File>chars8x8rBeach</File><Index>10</Index></AnimatedTexture>
		<HitSound>monster/elves_hit</HitSound>
		<DeathSound>monster/elves_death</DeathSound>
		<Size>150</Size>
		<MaxHitPoints>280</MaxHitPoints>
		<Defense>2</Defense>
		<Terrain>ShoreSand</Terrain>
		<Quest/>
		<Level>2</Level>
		<XpMult>1.6</XpMult>
		<SpawnProb>0.75</SpawnProb>
		
		<Projectile id="0">
			<ObjectId>Blade</ObjectId>
			<Damage>9</Damage>
			<Speed>60</Speed>
			<Size>60</Size>
			<LifetimeMS>800</LifetimeMS>
		</Projectile>

		<Behavior childIds="Bandit Enemy" cooldown="8" maxChildren="4">MakeMinions</Behavior>

		<State id="bold">
			<State id="warn_about_grenades">
				<Behavior prob="0.15" text="Catch!">Say</Behavior>
				<Transition afterTime="0.4">wimpy_grenade1</Transition>
			</State>
			<State id="wimpy_grenade1">
				<Behavior cooldown="100" type="targeted" radius="1.4" damage="12">GrenadeToss</Behavior>

				<Behavior bucket="movement" minAltitude="13">StayAbove</Behavior>
				<Behavior bucket="movement" speed="0.3">Wander</Behavior>

				<Transition afterTime="2">wimpy_grenade2</Transition>
			</State>
			<State id="wimpy_grenade2">
				<Behavior cooldown="100" type="targeted" radius="1.4" damage="12">GrenadeToss</Behavior>

				<Behavior bucket="movement" minAltitude="13">StayAbove</Behavior>
				<Behavior bucket="movement" speed="0.5">Wander</Behavior>

				<Transition afterTime="3">slow_follow</Transition>
			</State>		
			<State id="slow_follow">
				<Behavior projectileId="0" numShots="1" range="13" type="targeted" cooldown="1">Shoot</Behavior>

				<Behavior bucket="movement" minAltitude="13">StayAbove</Behavior>
				<Behavior bucket="movement" acquireRange="9" range="3.5" speed="0.4" duration="4">Follow</Behavior>

				<Transition afterTime="4">warn_about_grenades</Transition>
			</State>
			
			<Transition hitpointsLessThan=".45">meek</Transition>
		</State>
		<State id="meek">
			<Behavior prob="0.5" text="Forget this... run for it!">Say</Behavior>
			
			<Order>
				<Behavior bucket="movement" range="8" speed="0.5" acquireRange="15">KeepDistance</Behavior>	
			</Order>

			<Behavior bucket="movement" speed="0.5" distance="6">StayBack</Behavior>
			
			<Transition afterTime="12">bold</Transition>
		</State>

		<SoulboundLoot tier="1" prob=".1" threshold=".10">Weapon</SoulboundLoot>
		<SoulboundLoot tier="2" prob=".06" threshold=".18">Weapon</SoulboundLoot>
		<SoulboundLoot tier="1" prob=".1" threshold=".10">Armor</SoulboundLoot>
		<SoulboundLoot tier="2" prob=".06" threshold=".18">Armor</SoulboundLoot>
		<SoulboundLoot prob="0.12" threshold=".10">Health Potion</SoulboundLoot>
		<SoulboundLoot prob="0.14" threshold=".10">Magic Potion</SoulboundLoot>
	</Object>
	
