	<Object type="0x0935" id="Mysterious Crystal">
		<Group>Crystals</Group>
		<Enemy/>
		<Class>Character</Class>
		
		<!-- AESTHETICS -->	
		<AnimatedTexture><File>chars16x16dEncounters</File><Index>5</Index></AnimatedTexture>
		<HitSound>monster/stone_walls_hit</HitSound>
		<DeathSound>monster/stone_walls_death</DeathSound>
		
		<!-- DEFAULT PROPERTIES -->	
		<Size>120</Size>
		<MaxHitPoints>1000000</MaxHitPoints>
		<Defense>0</Defense>
		<Terrain>Mountains</Terrain>
		<SpawnProb>0.025</SpawnProb>
		<XpMult>0</XpMult>
		<PerRealmMax>1</PerRealmMax>
		
		<!-- PROJECTILES -->	
		<Projectile id="0">
			<ObjectId>White Bullet</ObjectId>
			<Damage>90</Damage>
			<Speed>10</Speed>
			<LifetimeMS>6000</LifetimeMS>
			<ConditionEffect duration="20">Quiet</ConditionEffect>
		</Projectile>
		
		<!-- STATES -->			

		<State id="Idle">
			<Behavior prob="0.1" text="Break the crystal for great rewards...">Say</Behavior>
			<Behavior prob="0.1" text="Help me...">Say</Behavior>
			<Transition hitpointsLessThan="0.999900">Instructions</Transition>
			<Transition afterTime="10">Idle</Transition>
		</State>

		<State id="Instructions">
			<Behavior type="Flash" color="FFFFFF" flashPeriod="2" flashRepeats="100">ShowEffect</Behavior>
			<Behavior prob="0.8" text="Fire upon this crystal with all your might for 5 seconds">Say</Behavior>
			<Behavior prob="0.8" text="If your attacks are weak, the crystal magically heals">Say</Behavior>
			<Behavior prob="0.8" text="Gather a large group to smash it open">Say</Behavior>
			<Transition hitpointsLessThan="0.998000">Evaluation</Transition> <!-- Do 1,000 damage to start evaluation -->	
		</State>

		<State id="Evaluation">
			<State id="Comment1">
				<Behavior broadcast="1" prob="1" text="Sweet treasure awaits for powerful adventurers!">Say</Behavior>
				<Behavior prob="0.4" text="Yes!  Smash my prison for great rewards!">Say</Behavior>
				<Transition afterTime="5">Comment2</Transition>
			</State>
			<State id="Comment2">
				<Behavior prob="0.3" text="If you are not very strong, this could kill you; If you are not yet powerful, stay away from the Crystal; New adventurers should stay away; That's the spirit. Lay your fire upon me.;So close...">Say</Behavior>
				<Transition afterTime="5">Comment3</Transition>
			</State>
			<State id="Comment3">
				<Behavior prob="0.4" text="I think you need more people...;Call all your friends to help you break the crystal!">Say</Behavior>
				<Transition afterTime="10">Comment2</Transition>
			</State>
			<Behavior targetGroups="Crystals" cooldown="5" >Heal</Behavior>
			<Transition hitpointsLessThan="0.950000">StartBreak</Transition> <!-- Do 50,000 damage in 5 seconds -->	
			<Transition afterTime="60">Fail</Transition>
		</State>

		<State id="Fail">
			<Behavior prob="1" text="Perhaps you need a bigger group. Ask others to join you!">Say</Behavior>
			<Behavior type="Flash" color="000000" flashPeriod="5" flashRepeats="1">ShowEffect</Behavior>
			<Behavior numShots="16" projectileId="0" cooldown="100" type="auto" defaultAngle="0" offset="0.0" angle="22.5">Shoot</Behavior>	
			<Behavior targetGroups="Crystals" cooldown="1" >Heal</Behavior>
			<Transition afterTime="5">Idle</Transition>
		</State>

		<State id="StartBreak">
			<Behavior prob="1" text="You cracked the crystal! Soon we shall emerge!; We are swelling with energy!!!;Come closer my children, and we will show you the meaning of our existence!;Come closer, let us feast upon your life force!">Say</Behavior>
			<Behavior rate="-2" minSize="80">ChangeSize</Behavior>
			<Behavior effect="Invulnerable">ConditionEffect</Behavior>
			<Behavior type="Flash" color="000000" flashPeriod="2" flashRepeats="10">ShowEffect</Behavior>
			<Transition afterTime="4">BreakCrystal</Transition>
		</State>

		<State id="BreakCrystal">
			<Behavior prob="1" text="This your reward! Imagine what evil even Oryx needs to keep locked up!;Yes, yes! I'm free! Absorb my energy to achieve ascension!;Free at last!">Say</Behavior>

			<Behavior childIds="Crystal Prisoner" cooldown="1000" maxChildren="1" startWithMinions="false">MakeMinions</Behavior>

			<Behavior range="0.0" numShots="16" projectileId="0">Explode</Behavior>	
		</State>
	</Object>

